{
  "name": "opencourts-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{src,tests,e2e}/**/*.{js,ts,css,html,json}\"",
    "format:check": "prettier --check \"{src,tests,e2e}/**/*.{js,ts,css,html,json}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "topojson-client": "^3.1.0"
  }
}